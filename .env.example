# SignalSafe Campus — Environment Configuration Template
# Copy this file to .env and provide your local/staging credentials.
# NEVER commit .env to version control.

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SignalSafe Campus API"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Supabase Project Configuration ---
# Project: signalsafe-campus
# Project Reference: xmhzqepctzkvbovurxvh
# Region: eu-west-1
SUPABASE_URL=https://xmhzqepctzkvbovurxvh.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Optional explicit JWKS URL for asymmetric verification:
SUPABASE_JWKS_URL=https://xmhzqepctzkvbovurxvh.supabase.co/auth/v1/.well-known/jwks.json
# Supabase JWT expected audience and issuer
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://xmhzqepctzkvbovurxvh.supabase.co/auth/v1

# --- CORS Configuration ---
# Comma-separated list of permitted origins (web dashboard, PWA, Chrome extension)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
# Set to true to permit chrome-extension:// origins during development
ALLOW_BROWSER_EXTENSIONS=true

# --- External Threat Intelligence Providers ---
# API keys are optional in local development (providers gracefully fall back to NO_MATCH/UNAVAILABLE)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
# Provider query bounds (seconds) and TTL caching (seconds)
THREAT_INTEL_TIMEOUT_SECONDS=3.0
THREAT_INTEL_CACHE_TTL_SECONDS=300

# --- Machine Learning Model Artifacts ---
# Model A: URL Phishing Classifier (.onnx or .joblib)
URL_MODEL_PATH=models/url_classifier_v1.onnx
URL_MODEL_CHECKSUM=
# Model B: QR Image Classifier (.onnx)
QR_MODEL_PATH=models/qr_classifier_v1.onnx
QR_MODEL_CHECKSUM=

# --- Detection Engine Parameters ---
SCORING_POLICY_VERSION=v1.0.0
