{
  "manifest_version": 3,
  "name": "SignalSafe Campus - Phishing & Threat Scanner",
  "version": "1.0.0",
  "description": "Cybersecurity assistant for campus users. Scans websites for phishing, malicious domains, and coordinates incident reporting.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SignalSafe Campus",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
